#!/usr/bin/env bash
set -uo pipefail

LOGFILE="{{ custom_logs.docker_update }}"
[[ ! -f "$LOGFILE" ]] && touch "$LOGFILE"

declare -A CHANGELOG_URLS=(
{% for key, value in docker.items() %}{% if value.version.changelog is defined %}
  [{{ key }}]="{{ value.version.changelog }}"
{% endif %}{% endfor %}
)

declare -A VERSION_CMD=(
{% for key, value in docker.items() %}{% if value.version.cmd is defined %}
  [{{ key }}]="docker exec {{ key }} {{ value.version.cmd }}"
{% endif %}{% endfor %}
)

declare -A VERSION_ENV=(
{% for key, value in docker.items() %}{% if value.version.env is defined %}
  [{{ key }}]="{{ value.version.env }}"
{% endif %}{% endfor %}
)

log_event() {
  local service="$1"
  local status="$2"
  local old_id="$3"
  local old_ver="$4"
  local new_id="$5"
  local new_ver="$6"
  local logline
  logline="$(jq -nc \
{% for jq, value in docker_upd_fields.items() %}
    --arg {{ jq }} "${{ value.bash }}" \
{% endfor %}
  '{
{% for json, value in docker_upd_fields.items() %}
    {{ json }}:${{ json }}{% if not loop.last %},
{% endif %}
{% endfor %}

  }')"
  echo "$logline" >> "$LOGFILE"
}

get_env_version() {
  local image_id="$1"
  local service_name="$2"
  docker image inspect "$image_id" 2>/dev/null \
    | jq -r --arg v "$service_name" '.[0].Config.Env[]? | select(startswith($v + "=")) | sub($v + "="; "")'
}

get_version() {
  local image_id="$1"
  local service_name="$2"
  local v
  v=$(docker image inspect --format '{{ '{{' }} index .Config.Labels "org.opencontainers.image.version" {{ '}}' }}' "$image_id" 2>/dev/null)
  if [[ -z "$v" ]]; then
    [[ -n "${VERSION_ENV[$service_name]:-}" ]] && \
      v=$(get_env_version "$image_id" "${VERSION_ENV[$service_name]}")
    [[ -n "${VERSION_CMD[$service_name]:-}" ]] && \
      v=$(eval ${VERSION_CMD[$service_name]})
    [[ -z "$v" ]] && \
      v="${image_id#sha256:}"
  fi
  echo "${v:0:12}"
}

notify() {
  local msg="$1"
  {{ telegram_script }} "$msg" status "$0"
}

for compose_file in /opt/*/docker-compose.yml; do
  project_dir="$(dirname "$compose_file")"
  project_name="$(basename "$project_dir")"

  # :latest tagged services (or without tag which means latest as well)
  services_to_check=$(
    docker compose -f "$compose_file" config \
    | yq -r '
        .services | to_entries[]
        | select(.value.image != null)
        | select(.value.image | test(":latest$") or (test(":") | not))
        | .key
      '
  )

  [[ -z "$services_to_check" ]] && continue

  for service in $services_to_check; do
    container_id=$(docker compose -f "$compose_file" ps -q "$service" 2>/dev/null)
    [[ -z "$container_id" ]] && continue

    old_image_id=$(docker inspect --format '{{ '{{' }}.Image{{ '}}' }}' "$container_id" 2>/dev/null)
    old_version=$(get_version "$old_image_id" "$service")

    if ! docker compose -f "$compose_file" pull "$service" >>"$LOGFILE.raw" 2>&1; then
      log_event "$project_name/$service" "pull_failed" "$old_image_id" "$old_version" "" ""
      notify "🔴 $(hostname) update check failed for $project_name/$service: pull error"
      continue
    fi

{# new_image_id=$(docker compose -f "$compose_file" config --images "$service" | xargs -r docker image inspect --format '{{ '{{' }}.Id{{ '}}' }}' 2>/dev/null) # gets all project images #}
{# image_ref=$(docker compose -f "$compose_file" config | yq -r --arg svc "$service" '.services[$svc].image') # python yq syntax doesnt work in go yq #}
    new_image_ref=$(svc="$service" yq -r '.services | to_entries[] | select(.value.container_name == strenv(svc)) | .value.image' "$compose_file") # think how to pass $service var inside yq
    new_image_id=$(docker image inspect --format '{{ '{{' }}.Id{{ '}}' }}' "$new_image_ref" 2>/dev/null)
    new_version=$(get_version "$new_image_id" "$service")

    if [[ "$old_image_id" == "$new_image_id" ]]; then
      log_event "$project_name/$service" "up_to_date" "$old_image_id" "$old_version" "$new_image_id" "$new_version"
      continue
    fi

{# added for debugging reasons #}
    if [[ -z "$new_image_id" ]]; then
      log_event "$project_name/$service" "no_new_image_id" "$old_image_id" "$old_version" "" ""
      notify "🔴 $(hostname) failed to get new image id of $project_name/$service after pull"
      continue
    fi

    backup_tag="${service}:backup-$(date +%Y%m%d_%H%M%S)"
    docker commit "$container_id" "$backup_tag" >/dev/null 2>&1

    # keep only 3 last backups per service
    docker images --filter "reference=${service}:backup-*" --format '{{ '{{' }}.Repository{{ '}}' }}:{{ '{{' }}.Tag{{ '}}' }}' \
      | sort -r | tail -n +4 | xargs -r docker rmi >/dev/null 2>&1

    if docker compose -f "$compose_file" up -d "$service" >>"$LOGFILE.raw" 2>&1; then
      log_event "$project_name/$service" "updated" "$old_image_id" "$old_version" "$new_image_id" "$new_version"
      [[ -n "${CHANGELOG_URLS[$service]}" ]] && changelog=$'\n'"changelog: ${CHANGELOG_URLS[$service]}" || changelog=""
      notify "🟢 $(hostname) updated $project_name/$service
version: <code>${old_version}</code> → <code>${new_version}</code> ${changelog}"
    else
      log_event "$project_name/$service" "recreate_failed" "$old_image_id" "$old_version" "$new_image_id" "$new_version"
      notify "🔴 $(hostname) failed to recreate $project_name/$service after pull"
    fi
  done
done
