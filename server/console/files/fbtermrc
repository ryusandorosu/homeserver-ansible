### https://github.com/xlucn/dotfiles/blob/master/fbterm/README.md

font-names=JetBrainsMono NF
font-size=14

# max scroll-back history lines of every window, value must be [0 - 65535], 0 means disable it
history-lines=0

# up to 5 additional text encodings, multiple encodings must be seperated by ','
# run 'iconv --list' to get available encodings.
#text-encodings=

# cursor shape: 0 = underline, 1 = block
# cursor flash interval in milliseconds, 0 means disable flashing
cursor-shape=1
cursor-interval=0

# additional ascii chars considered as part of a word while auto-selecting text, except ' ', 0-9, a-z, A-Z
word-chars=._-

# specify the favorite input method program to run
#input-method=

# run this from fbterm once: echo -en "\e]P7ffffff"
# https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/wezterm/Hurtado.toml
color-background=#000000
color-foreground=#dbdbdb
color-0=#404040
color-1=#d51d00
color-2=#a5de54
color-3=#fbe84a
color-4=#89beff
color-5=#c001c1
color-6=#86eafe
color-7=#dbdbdb
color-8=#575757
color-9=#ff1b00
color-10=#a5e055
color-11=#fbe74a
color-12=#496487
