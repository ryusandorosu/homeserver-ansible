services:
  oauth2-proxy:
    image: quay.io/oauth2-proxy/oauth2-proxy:latest
    container_name: {{ docker.nginx_auth.name }}
    restart: unless-stopped
    volumes:
      - {{ oauth_config }}:{{ oauth_config }}
    command:
      - --config={{ oauth_config }}
    ports:
      - "{{ localhost }}:{{ docker.nginx_auth.port }}:{{ docker.nginx_auth.port }}"
